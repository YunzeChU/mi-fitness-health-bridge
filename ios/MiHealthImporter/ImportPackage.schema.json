{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mi-health-importer/schema/import-package-v1.json",
  "title": "Mi Health Importer structured import package",
  "description": "The sole accepted input contract. It is a neutral, camelCase package format; it is not a vendor-export schema or a converter.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "$ref": "#/$defs/opaqueIdentifier" },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "opaqueIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "record": {
      "oneOf": [
        { "$ref": "#/$defs/sleepRecord" },
        { "$ref": "#/$defs/workoutRecord" },
        { "$ref": "#/$defs/cyclingDistanceRecord" },
        { "$ref": "#/$defs/heartRateRecord" },
        { "$ref": "#/$defs/restingHeartRateRecord" },
        { "$ref": "#/$defs/oxygenSaturationRecord" },
        { "$ref": "#/$defs/stepCountRecord" },
        { "$ref": "#/$defs/activeEnergyRecord" }
      ]
    },
    "baseRecord": {
      "type": "object",
      "required": ["sourceId", "type"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/opaqueIdentifier" },
        "type": { "type": "string" }
      }
    },
    "sleepRecord": {
      "allOf": [
        { "$ref": "#/$defs/baseRecord" },
        {
          "properties": {
            "type": { "const": "sleep" },
            "startDate": { "$ref": "#/$defs/timestamp" },
            "endDate": { "$ref": "#/$defs/timestamp" },
            "sleepStage": { "enum": ["awake", "inBed", "asleepCore", "asleepDeep", "asleepREM", "asleepUnspecified"] }
          },
          "required": ["sourceId", "type", "startDate", "endDate", "sleepStage"]
        }
      ],
      "unevaluatedProperties": false
    },
    "workoutRecord": {
      "allOf": [
        { "$ref": "#/$defs/baseRecord" },
        {
          "properties": {
            "type": { "const": "workout" },
            "startDate": { "$ref": "#/$defs/timestamp" },
            "endDate": { "$ref": "#/$defs/timestamp" },
            "workoutActivity": { "enum": ["walking", "running", "cycling", "hiking", "swimming", "traditionalStrengthTraining", "functionalStrengthTraining", "yoga", "other"] },
            "distanceMeters": { "type": "number", "minimum": 0, "maximum": 2000000 },
            "activeEnergyKilocalories": { "type": "number", "minimum": 0, "maximum": 100000 }
          },
          "required": ["sourceId", "type", "startDate", "endDate", "workoutActivity"]
        }
      ],
      "unevaluatedProperties": false
    },
    "quantityBase": {
      "allOf": [
        { "$ref": "#/$defs/baseRecord" },
        {
          "properties": {
            "date": { "$ref": "#/$defs/timestamp" },
            "value": { "type": "number" }
          },
          "required": ["sourceId", "type", "date", "value"]
        }
      ],
      "unevaluatedProperties": false
    },
    "cyclingDistanceRecord": { "allOf": [{ "$ref": "#/$defs/quantityBase" }, { "properties": { "type": { "const": "cyclingDistance" }, "value": { "minimum": 0, "maximum": 2000000 } } }], "unevaluatedProperties": false },
    "heartRateRecord": { "allOf": [{ "$ref": "#/$defs/quantityBase" }, { "properties": { "type": { "const": "heartRate" }, "value": { "exclusiveMinimum": 0, "maximum": 300 } } }], "unevaluatedProperties": false },
    "restingHeartRateRecord": { "allOf": [{ "$ref": "#/$defs/quantityBase" }, { "properties": { "type": { "const": "restingHeartRate" }, "value": { "exclusiveMinimum": 0, "maximum": 300 } } }], "unevaluatedProperties": false },
    "oxygenSaturationRecord": { "allOf": [{ "$ref": "#/$defs/quantityBase" }, { "properties": { "type": { "const": "oxygenSaturation" }, "value": { "minimum": 0, "maximum": 1 } } }], "unevaluatedProperties": false },
    "stepCountRecord": { "allOf": [{ "$ref": "#/$defs/quantityBase" }, { "properties": { "type": { "const": "stepCount" }, "value": { "minimum": 0, "maximum": 10000000 } } }], "unevaluatedProperties": false },
    "activeEnergyRecord": { "allOf": [{ "$ref": "#/$defs/quantityBase" }, { "properties": { "type": { "const": "activeEnergyBurned" }, "value": { "minimum": 0, "maximum": 100000 } } }], "unevaluatedProperties": false }
  }
}
